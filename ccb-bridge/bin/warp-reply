#!/usr/bin/env python
"""warp-reply — Submit a reply to the Warp LocalAgentBus

Usage:
    warp-reply --req-id <id> --content-file <path>
    warp-reply --req-id <id> --content <text>
    echo "reply text" | warp-reply --req-id <id> --stdin
"""

import sys
import os
import time

if sys.stdout and hasattr(sys.stdout, 'reconfigure'):
    try:
        sys.stdout.reconfigure(errors='replace')
    except Exception:
        pass

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "lib"))

_LOG_DIR = os.path.join(os.path.expanduser("~"), ".warp-ccb", "logs")
os.makedirs(_LOG_DIR, exist_ok=True)


def _log(msg):
    ts = time.strftime("%Y-%m-%d %H:%M:%S")
    line = f"[{ts}] [warp-reply] {msg}"
    try:
        with open(os.path.join(_LOG_DIR, "ccb.log"), "a", encoding="utf-8") as f:
            f.write(line + "\n")
    except Exception:
        pass


def main():
    req_id = None
    content = None
    content_file = None
    use_stdin = False
    caller = None
    mode = "dual"

    i = 1
    while i < len(sys.argv):
        arg = sys.argv[i]
        if arg == "--req-id" and i + 1 < len(sys.argv):
            req_id = sys.argv[i + 1]
            i += 2
        elif arg == "--content" and i + 1 < len(sys.argv):
            content = sys.argv[i + 1]
            i += 2
        elif arg == "--content-file" and i + 1 < len(sys.argv):
            content_file = sys.argv[i + 1]
            i += 2
        elif arg == "--stdin":
            use_stdin = True
            i += 1
        elif arg == "--caller" and i + 1 < len(sys.argv):
            caller = sys.argv[i + 1]
            i += 2
        elif arg == "--mode" and i + 1 < len(sys.argv):
            mode = sys.argv[i + 1]
            i += 2
        elif arg in ("-h", "--help"):
            print(__doc__.strip())
            sys.exit(0)
        else:
            print(f"Error: unknown option: {arg}", file=sys.stderr)
            sys.exit(1)

    if not req_id:
        print("Error: --req-id is required", file=sys.stderr)
        sys.exit(1)

    if content is not None:
        pass
    elif content_file:
        try:
            with open(content_file, "r", encoding="utf-8") as f:
                content = f.read()
        except Exception as e:
            print(f"Error reading content file: {e}", file=sys.stderr)
            sys.exit(1)
    elif use_stdin:
        content = sys.stdin.read()
    else:
        print("Error: must specify one of --content, --content-file, or --stdin", file=sys.stderr)
        sys.exit(1)

    if not content or not content.strip():
        print("Error: reply content is empty", file=sys.stderr)
        sys.exit(1)

    _log(f"START req_id={req_id} mode={mode} caller={caller} content_len={len(content)}")

    errors = []

    # --- SQLite path ---
    if mode in ("sqlite", "dual"):
        try:
            from bus_sqlite import BusDB
            db = BusDB()
            db.reply(req_id, content, caller=caller, source="explicit_reply", confidence=1.0)
            db.close()
            _log(f"SQLite reply OK req_id={req_id}")
        except Exception as e:
            _log(f"SQLite reply FAILED: {e}")
            if mode == "sqlite":
                print(f"Error (sqlite): {e}", file=sys.stderr)
                sys.exit(1)
            errors.append(f"sqlite: {e}")

    # --- TCP path ---
    if mode in ("tcp", "dual"):
        try:
            from bus_client import reply as bus_reply
            response = bus_reply(req_id, content, caller=caller)
            _log(f"TCP reply response: ok={response.get('ok')} type={response.get('type')} already_finalized={response.get('already_finalized')} message={response.get('message')}")
            if response.get("ok"):
                pass
            else:
                if mode == "tcp":
                    print(f"[CCB_REPLY_REJECTED req_id={req_id}] {response.get('message', 'unknown error')}", file=sys.stderr)
                    sys.exit(1)
                errors.append(f"tcp: {response.get('message', 'unknown')}")
        except Exception as e:
            _log(f"TCP reply FAILED: {type(e).__name__}: {e}")
            if mode == "tcp":
                print(f"Error (tcp): {e}", file=sys.stderr)
                sys.exit(1)
            errors.append(f"tcp: {e}")

    if errors and not any("sqlite" not in e for e in errors):
        print(f"[CCB_REPLY_ACCEPTED req_id={req_id}]")
        if errors:
            print(f"warnings: {'; '.join(errors)}", file=sys.stderr)
    else:
        print(f"[CCB_REPLY_ACCEPTED req_id={req_id}]")
        print(f"status: accepted")

    _log(f"DONE req_id={req_id} errors={errors}")


if __name__ == "__main__":
    main()
