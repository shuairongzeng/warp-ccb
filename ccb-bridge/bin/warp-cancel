#!/usr/bin/env python
"""warp-cancel — Cancel a pending request

Supports two modes:
  --mode tcp     : Use TCP JSONL bus (original)
  --mode sqlite  : Use SQLite bus (default)
  --mode dual    : Cancel via both channels
"""

import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "lib"))


def main():
    if len(sys.argv) < 2:
        print("Usage: warp-cancel <req_id> [--mode <tcp|sqlite|dual>]")
        sys.exit(1)

    req_id = sys.argv[1]
    mode = "sqlite"

    i = 2
    while i < len(sys.argv):
        if sys.argv[i] == "--mode" and i + 1 < len(sys.argv):
            mode = sys.argv[i + 1]
            i += 2
        else:
            i += 1

    cancelled = False

    # --- SQLite path ---
    if mode in ("sqlite", "dual"):
        try:
            from bus_sqlite import BusDB
            db = BusDB()
            ok = db.cancel(req_id)
            db.close()
            if ok:
                print(f"Cancelled (sqlite): {req_id}")
                cancelled = True
        except Exception:
            pass

    # --- TCP path ---
    if mode in ("tcp", "dual"):
        try:
            from bus_client import cancel
            response = cancel(req_id)
            if response.get("ok"):
                print(f"Cancelled (tcp): {req_id}")
                cancelled = True
        except Exception:
            pass

    if not cancelled:
        print(f"Error: could not cancel {req_id}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
