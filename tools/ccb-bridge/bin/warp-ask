#!/usr/bin/env python3
"""warp-ask — Send a prompt to a CLI agent via Warp LocalAgentBus"""

import sys
import os

# Fix Windows console encoding for Unicode output
if sys.stdout and hasattr(sys.stdout, 'reconfigure'):
    try:
        sys.stdout.reconfigure(encoding='utf-8', errors='replace')
    except Exception:
        pass

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "lib"))
from bus_client import ask, wait


def main():
    if len(sys.argv) < 3:
        print("Usage: warp-ask <provider> <message> [--queue] [--wait] [--timeout N] [--caller <caller>] [--cwd <dir>] [--session-id <id>]")
        print("Providers: claude, codex, gemini, opencode, droid")
        sys.exit(1)

    provider = sys.argv[1]
    message = sys.argv[2]
    caller = "cli"
    cwd = None
    session_id = None
    queue = False
    do_wait = False
    wait_timeout = 300

    i = 3
    while i < len(sys.argv):
        if sys.argv[i] == "--caller" and i + 1 < len(sys.argv):
            caller = sys.argv[i + 1]
            i += 2
        elif sys.argv[i] == "--cwd" and i + 1 < len(sys.argv):
            cwd = sys.argv[i + 1]
            i += 2
        elif sys.argv[i] == "--session-id" and i + 1 < len(sys.argv):
            session_id = sys.argv[i + 1]
            i += 2
        elif sys.argv[i] == "--queue":
            queue = True
            i += 1
        elif sys.argv[i] == "--wait":
            do_wait = True
            i += 1
        elif sys.argv[i] == "--timeout" and i + 1 < len(sys.argv):
            wait_timeout = int(sys.argv[i + 1])
            i += 2
        else:
            i += 1

    try:
        response, req_id = ask(provider, message, caller=caller, cwd=cwd, session_id=session_id, queue=queue)
        if not response.get("ok"):
            print(f"Error: {response.get('message', 'unknown error')}", file=sys.stderr)
            sys.exit(1)

        if response.get("type") == "ask_skipped":
            print(f"[CCB_SKIPPED provider={provider}]")
            print(f"req_id: {response.get('req_id', req_id)}")
            print(f"reason: {response.get('reason', 'self_request_skipped')}")
            return

        if do_wait:
            print(f"[{req_id}] waiting for {provider}...")
            result = wait(req_id=req_id, timeout=wait_timeout, cwd=cwd)
            if result.get("ok"):
                status = result.get("status", "unknown")
                content = result.get("content", "")
                elapsed = result.get("elapsed_ms", 0)
                print(f"[{req_id}] ({status}) {elapsed}ms")
                if content:
                    print(content)
            else:
                print(f"Error: {result.get('message', 'unknown error')}", file=sys.stderr)
                sys.exit(1)
        else:
            print(f"[CCB_ASYNC_SUBMITTED provider={provider}]")
            print(f"req_id: {req_id}")
            sid = response.get("session_id")
            if sid:
                print(f"session: {sid}")
            if queue:
                print(f"queued: true")
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
