#!/usr/bin/env python
"""warp-reply — Submit a reply to the Warp LocalAgentBus

Used by CLI agents to submit their reply directly via the bus,
bypassing the terminal marker capture path.

Usage:
    warp-reply --req-id <id> --content-file <path>
    warp-reply --req-id <id> --content <text>
    echo "reply text" | warp-reply --req-id <id> --stdin
"""

import sys
import os

# Fix Windows console encoding for Unicode output
if sys.stdout and hasattr(sys.stdout, 'reconfigure'):
    try:
        sys.stdout.reconfigure(encoding='utf-8', errors='replace')
    except Exception:
        pass

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "lib"))
from bus_client import reply as bus_reply


def main():
    req_id = None
    content = None
    content_file = None
    use_stdin = False
    caller = None

    i = 1
    while i < len(sys.argv):
        arg = sys.argv[i]
        if arg == "--req-id" and i + 1 < len(sys.argv):
            req_id = sys.argv[i + 1]
            i += 2
        elif arg == "--content" and i + 1 < len(sys.argv):
            content = sys.argv[i + 1]
            i += 2
        elif arg == "--content-file" and i + 1 < len(sys.argv):
            content_file = sys.argv[i + 1]
            i += 2
        elif arg == "--stdin":
            use_stdin = True
            i += 1
        elif arg == "--caller" and i + 1 < len(sys.argv):
            caller = sys.argv[i + 1]
            i += 2
        elif arg in ("-h", "--help"):
            print(__doc__.strip())
            sys.exit(0)
        else:
            print(f"Error: unknown option: {arg}", file=sys.stderr)
            sys.exit(1)

    if not req_id:
        print("Error: --req-id is required", file=sys.stderr)
        print("Usage: warp-reply --req-id <id> (--content <text> | --content-file <path> | --stdin)", file=sys.stderr)
        sys.exit(1)

    # Resolve content from one of the three sources
    if content is not None:
        pass  # already set
    elif content_file:
        try:
            with open(content_file, "r", encoding="utf-8") as f:
                content = f.read()
        except Exception as e:
            print(f"Error reading content file: {e}", file=sys.stderr)
            sys.exit(1)
    elif use_stdin:
        content = sys.stdin.read()
    else:
        print("Error: must specify one of --content, --content-file, or --stdin", file=sys.stderr)
        sys.exit(1)

    if not content or not content.strip():
        print("Error: reply content is empty", file=sys.stderr)
        sys.exit(1)

    try:
        response = bus_reply(req_id, content, caller=caller)
        if response.get("ok"):
            print(f"[CCB_REPLY_ACCEPTED req_id={req_id}]")
            print(f"status: {response.get('status', 'accepted')}")
        else:
            msg = response.get("message", "unknown error")
            print(f"[CCB_REPLY_REJECTED req_id={req_id}] {msg}", file=sys.stderr)
            sys.exit(1)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
