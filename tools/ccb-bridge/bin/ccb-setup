#!/usr/bin/env python3
"""ccb-setup — Install CCB Warp LocalAgentBus tools

Adds ccb-bridge/bin to PATH and installs skills for Claude and Codex.
"""

import json
import os
import sys
import shutil

BRIDGE_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..")
BIN_DIR = os.path.join(BRIDGE_DIR, "bin")
SKILLS_DIR = os.path.join(BRIDGE_DIR, "skills")

# Skill content template — uses just command names (warp-ask, warp-ping, etc.)
# so it works regardless of where ccb-bridge is installed, as long as bin/ is in PATH

CLAUDE_SKILL = r'''---
name: warp-ask
description: Send a message to another AI agent via Warp LocalAgentBus. Default is async (non-blocking). Use this to collaborate with other agents (claude/codex/gemini/opencode/droid/kimi/goose).
metadata:
  short-description: Send message to another agent (async by default)
---

# Warp Ask - Cross-Agent Communication

Send a message to another AI agent running in Warp.

## Available Agents

- `claude` - Claude (Anthropic)
- `codex` - Codex (OpenAI)
- `gemini` - Gemini (Google)
- `opencode` - OpenCode
- `droid` - Droid
- `kimi` - Kimi (Moonshot)
- `goose` - Goose (Block)

## Multi-Instance Auto-Isolation

Warp sets `WARP_BUS_PID` in every terminal. The `warp-ask` command uses this
to automatically route messages to the correct Warp instance.

## Step 1: Check Agent Status (MANDATORY)

```powershell
warp-ping $PROVIDER
```

If "not online", report that the agent is unavailable.

## Step 2: Send Message — Async (DEFAULT)

Always use async mode. This does NOT block — you can send multiple messages
and do other work while waiting for replies.

```powershell
warp-ask $PROVIDER "$MESSAGE" --caller claude
```

Returns immediately with a `req_id`. Remember it.

## Step 3: Wait for Reply (BACKGROUND)

When you need the reply before continuing, use `warp-wait` in a **background Bash** process (NO timeout). You will be automatically notified when it completes.

```powershell
# Use Bash tool with run_in_background=true
warp-wait $REQ_ID
```

Do NOT use `--timeout` — the background process will wait until the reply arrives.

You can also check status at any time with:

```powershell
warp-pend $PROVIDER
```

Or check a specific request: `warp-pend $PROVIDER --req-id $REQ_ID`

## Blocking Mode (AVOID)

Do NOT use `--wait` on `warp-ask` — it blocks the entire session. Always prefer async send + background `warp-wait`.

```powershell
# AVOID this — blocks entire session:
warp-ask $PROVIDER "$MESSAGE" --wait --timeout 60
```

## Rules

- Default to async mode for sending (`warp-ask` without `--wait`).
- When you need the reply, launch `warp-wait $REQ_ID` as a **background Bash** process (run_in_background=true, NO timeout).
- You can send to multiple providers without waiting for each reply.
- After background wait completes, use `warp-pend $PROVIDER` to read the reply.

## Examples

- `warp-ping codex` — check if codex is online
- `warp-ask codex "What is 2+2?" --caller claude` — async send
- Background Bash: `warp-wait 20260514-1234-abcd` — wait for reply (notified on completion)
- `warp-pend codex` — check latest reply from codex
'''

CODEX_SKILL = r'''---
name: warp-ask
description: Send a message to another AI agent via Warp LocalAgentBus. Default is async (non-blocking). Use this to collaborate with other agents (claude/codex/gemini/opencode/droid/kimi/goose).
metadata:
  short-description: Send message to another agent (async by default)
---

