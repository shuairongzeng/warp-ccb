#!/usr/bin/env python3
"""warp-cancel — Cancel a pending request via Warp LocalAgentBus"""

import sys
import os

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "lib"))
from bus_client import cancel


def main():
    if len(sys.argv) < 2:
        print("Usage: warp-cancel <req_id>")
        sys.exit(1)

    req_id = sys.argv[1]

    try:
        response = cancel(req_id)
        if response.get("ok"):
            print(f"Cancelled: {req_id}")
        else:
            print(f"Error: {response.get('message', 'unknown error')}", file=sys.stderr)
            sys.exit(1)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
