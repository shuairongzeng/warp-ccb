#!/usr/bin/env python3
"""warp-pend — View latest replies from a CLI agent via Warp LocalAgentBus"""

import sys
import os
import json

# Fix Windows console encoding for Unicode output
if sys.stdout and hasattr(sys.stdout, 'reconfigure'):
    try:
        sys.stdout.reconfigure(encoding='utf-8', errors='replace')
    except Exception:
        pass

sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "lib"))
from bus_client import pend


def main():
    if len(sys.argv) < 2:
        print("Usage: warp-pend <provider> [--count N] [--req-id <id>] [--cwd <dir>]")
        print("Providers: claude, codex, gemini, opencode, droid")
        sys.exit(1)

    provider = sys.argv[1]
    count = 1
    req_id = None
    cwd = None

    i = 2
    while i < len(sys.argv):
        if sys.argv[i] == "--count" and i + 1 < len(sys.argv):
            count = int(sys.argv[i + 1])
            i += 2
        elif sys.argv[i] == "--req-id" and i + 1 < len(sys.argv):
            req_id = sys.argv[i + 1]
            i += 2
        elif sys.argv[i] == "--cwd" and i + 1 < len(sys.argv):
            cwd = sys.argv[i + 1]
            i += 2
        else:
            i += 1

    try:
        response = pend(provider, count=count, req_id=req_id, cwd=cwd)
        if response.get("ok"):
            replies = response.get("replies", [])
            if not replies:
                print(f"No replies from {provider}")
            for reply in replies:
                status = reply.get("status", "unknown")
                content = reply.get("content", "")
                print(f"[{reply.get('req_id', '?')}] ({status}) {content}")
        else:
            print(f"Error: {response.get('message', 'unknown error')}", file=sys.stderr)
            sys.exit(1)
    except Exception as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
